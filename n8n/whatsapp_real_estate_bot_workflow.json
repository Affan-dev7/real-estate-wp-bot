          "name": "OpenAI Account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const aiRaw = $input.first().json.message.content || $input.first().json.text || '{}';\nlet aiData = {};\ntry {\n  aiData = JSON.parse(aiRaw);\n} catch (e) {\n  aiData = {\n    reply_text: 'Assalam o alaikum! Shukriya rabta karne ka. Hamare pas premium options available hain. Aap ka budget aur required size kya hai?',\n    recommended_listing_id: null,\n    extracted_lead: {}\n  };\n}\n\nconst handoverData = $('Analyze Human Handoff & Bot State').first().json;\n\nreturn [{\n  json: {\n    ...handoverData,\n    aiReply: aiData.reply_text || 'Assalam o alaikum! How can we assist you with property today?',\n    recommendedListingId: aiData.recommended_listing_id || null,\n    extractedLead: aiData.extracted_lead || {}\n  }\n}];"
      },
