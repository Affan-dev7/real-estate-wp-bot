      "id": "node-create-lead",
      "name": "Create New Lead in Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1660,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const parseData = $('Parse WhatsApp Payload').first().json;\nlet lead = null;\n\n// If newly created\nconst created = $input.first()?.json;\nif (created && (created.id || (Array.isArray(created) && created[0]?.id))) {\n  lead = Array.isArray(created) ? created[0] : created;\n} else {\n  lead = $('Process Lead Status').first().json.lead;\n}\n\n// Human handoff keyword check in English, Roman Urdu & Urdu script\nconst text = (parseData.messageText || '').toLowerCase();\nconst humanKeywords = [\n  'human',\n  'agent',\n  'call me',\n  'call karein',\n  'call karo',\n  'phone',\n  'number dein',\n  'baat karni',\n  'rabta',\n  'live person',\n  'insan',\n  'banda',\n  'owner se',\n  'کال',\n  'ایجنٹ',\n  'بات کرنی'\n];\n\nconst requestedHuman = humanKeywords.some(kw => text.includes(kw));\n\nlet botState = 'active';\nif (lead.bot_paused) {\n  botState = 'paused_already';\n} else if (requestedHuman) {\n  botState = 'requesting_human';\n}\n\nreturn [{\n  json: {\n    ...parseData,\n    lead,\n    leadId: lead.id,\n    botState,\n    requestedHuman\n  }\n}];"
      },
