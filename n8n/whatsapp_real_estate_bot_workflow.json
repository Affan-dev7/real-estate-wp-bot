    {
      "parameters": {
        "jsCode": "const prev = $('Parse WhatsApp Payload').first().json;\nconst existingLeads = $input.all().map(i => i.json);\n\nlet lead = null;\nlet isNewLead = false;\n\nif (existingLeads.length > 0 && existingLeads[0].id) {\n  lead = existingLeads[0];\n} else {\n  isNewLead = true;\n}\n\nreturn [{\n  json: {\n    ...prev,\n    lead,\n    isNewLead\n  }\n}];"
      },
      "id": "node-check-lead-exists",
      "name": "Process Lead Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.isNewLead }}",
              "value2": true
            }
          ]
        }
