      "name": "WhatsApp Verification (GET)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        220,
        80
      ],
      "webhookId": "whatsapp-agency-get"
    },
    {
      "parameters": {
        "jsCode": "// =====================================================================\n// ⚙️ CONFIGURE THIS AGENCY'S CREDENTIALS & DETAILS BELOW:\n// (Double-click this node to edit your agency settings)\n// =====================================================================\n\nconst agencyConfig = {\n  // 1. Agency ID (from Supabase public.agencies table)\n  agencyId: \"00000000-0000-0000-0000-000000000001\",\n\n  // 2. Agency Name & Contact (used by AI in customer conversations)\n  agencyName: \"Al-Raziq Estate & Builders\",\n  agentPhone: \"+92 300 8251940\",\n  primaryCity: \"Karachi & Lahore\",\n\n  // 3. Supabase Credentials\n  supabaseUrl: \"https://YOUR_PROJECT_REF.supabase.co\",\n  supabaseServiceRoleKey: \"YOUR_SUPABASE_SERVICE_ROLE_KEY\",\n\n  // 4. Meta WhatsApp Cloud API Credentials\n  whatsappPhoneNumberId: \"YOUR_WHATSAPP_PHONE_NUMBER_ID\",\n  whatsappAccessToken: \"YOUR_WHATSAPP_PERMANENT_ACCESS_TOKEN\",\n\n  // 5. Secret verification token (entered in Meta Developers Webhook settings)\n  webhookVerifyToken: \"agency_verify_token_123\"\n};\n\n// Attach agency configuration directly to the incoming webhook payload\nconst webhookData = $input.first()?.json || {};\n\nreturn [{\n  json: {\n    ...webhookData,\n    agencyConfig\n  }\n}];"
      },
      "id": "node-agency-config",
      "name": "⚙️ Agency & Bot Settings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.query['hub.mode'] }}",
              "value2": "subscribe"
            }
          ]
        }
      },
      "id": "node-verify-check",
      "name": "Is Meta Verification?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        460,
        80
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.query['hub.challenge'] }}",
        "options": {}
      },
      "id": "node-respond-challenge",
      "name": "Return Meta Challenge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        700,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extract incoming message details from Meta WhatsApp Cloud API payload\nconst item = $input.first().json;\nconst body = item.body || item;\nconst config = item.agencyConfig || {};\n\nlet senderPhone = '';\nlet customerName = 'Customer';\nlet messageText = '';\nlet messageId = '';\nlet messageTimestamp = new Date().toISOString();\nlet isMessage = false;\n\n// WhatsApp Cloud API payload structure validation\nif (body && body.entry && body.entry[0] && body.entry[0].changes && body.entry[0].changes[0]) {\n  const value = body.entry[0].changes[0].value;\n  \n  // Check if it's an incoming customer message (ignore delivery status receipts)\n  if (value.messages && value.messages[0]) {\n    isMessage = true;\n    const msg = value.messages[0];\n    messageId = msg.id || '';\n    \n    // Normalize phone number to +92 Pakistani standard format\n    let rawPhone = msg.from || '';\n    if (rawPhone.startsWith('92')) {\n      senderPhone = '+' + rawPhone;\n    } else if (rawPhone.startsWith('03')) {\n      senderPhone = '+92' + rawPhone.substring(1);\n    } else if (rawPhone.startsWith('+')) {\n      senderPhone = rawPhone;\n    } else {\n      senderPhone = '+92' + rawPhone;\n    }\n    \n    // Customer name from WhatsApp contact profile\n    if (value.contacts && value.contacts[0] && value.contacts[0].profile) {\n      customerName = value.contacts[0].profile.name || 'Customer';\n    }\n    \n    // Message text body\n    if (msg.type === 'text' && msg.text) {\n      messageText = msg.text.body || '';\n    } else if (msg.type === 'interactive' && msg.interactive) {\n      messageText = msg.interactive.button_reply?.title || msg.interactive.list_reply?.title || '';\n    } else {\n      messageText = `[Customer sent ${msg.type || 'media'}]`;\n    }\n    \n    if (msg.timestamp) {\n      messageTimestamp = new Date(parseInt(msg.timestamp) * 1000).toISOString();\n    }\n  }\n}\n\nreturn [{\n  json: {\n    isMessage,\n    senderPhone,\n    customerName,\n    messageText,\n    messageId,\n    messageTimestamp,\n    agencyId: config.agencyId,\n    agencyName: config.agencyName,\n    agentPhone: config.agentPhone,\n    primaryCity: config.primaryCity,\n    supabaseUrl: config.supabaseUrl,\n    supabaseServiceRoleKey: config.supabaseServiceRoleKey,\n    whatsappPhoneNumberId: config.whatsappPhoneNumberId,\n    whatsappAccessToken: config.whatsappAccessToken\n  }\n}];"
      },
      "id": "node-parse-whatsapp",
      "name": "Parse WhatsApp Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        300
      ]
